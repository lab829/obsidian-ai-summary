{
  "name": "obsidian-ai-summary",
  "version": "0.1.2",
  "description": "Obsidian plugin that detects ai_summary: pending notes, inserts an AI summary block at the top of the note body, and marks them generated.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "pnpm type-check && node esbuild.config.mjs production",
    "sync:plugin": "node scripts/sync-plugin.mjs",
    "build:sync": "pnpm build && pnpm sync:plugin",
    "lint": "eslint src vitest.config.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "preinstall": "node check-pnpm.js"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@10.30.0",
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@types/node": "25.5.0",
    "@vitest/coverage-v8": "4.1.2",
    "esbuild": "0.27.4",
    "eslint": "9.30.1",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.4.0",
    "obsidian": "1.8.7",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.2",
    "vitest": "4.1.2"
  }
}
